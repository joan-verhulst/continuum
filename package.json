{
    "name": "continuum",
    "version": "0.1.0",
    "description": "A quiet, dense design system for tool UI: one default look, a theme builder, Base UI primitives and Tailwind v4.",
    "license": "UNLICENSED",
    "private": true,
    "type": "module",
    "sideEffects": [
        "*.css"
    ],
    "exports": {
        ".": "./src/index.ts",
        "./charts": "./src/charts/index.ts",
        "./styles.css": "./dist/styles.css",
        "./theme.css": "./src/styles/theme.css",
        "./tokens.css": "./src/styles/tokens.css"
    },
    "files": [
        "src",
        "dist"
    ],
    "scripts": {
        "dev": "pnpm --filter playground dev",
        "build": "node scripts/build-css.mjs && pnpm --filter playground build",
        "build:css": "node scripts/build-css.mjs",
        "type-check": "tsc --noEmit && pnpm --filter playground type-check",
        "lint": "biome check",
        "lint:fix": "biome check --write",
        "build:skill": "node scripts/build-css.mjs && node scripts/build-skill.mjs",
        "install:skill": "pnpm build:skill && node scripts/build-skill.mjs --install"
    },
    "peerDependencies": {
        "react": ">=19",
        "react-dom": ">=19"
    },
    "dependencies": {
        "@base-ui/react": "1.8.0",
        "@number-flow/react": "^0.6.2",
        "@visx/curve": "4.0.1-alpha.0",
        "@visx/event": "4.0.1-alpha.0",
        "@visx/grid": "4.0.1-alpha.0",
        "@visx/group": "4.0.1-alpha.0",
        "@visx/responsive": "4.0.1-alpha.0",
        "@visx/scale": "4.0.1-alpha.0",
        "@visx/shape": "4.0.1-alpha.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "d3-array": "^3.2.4",
        "d3-shape": "^3.2.0",
        "lucide-react": "^1.60.0",
        "motion": "^12.23.24",
        "react-day-picker": "10.0.0",
        "tailwind-merge": "^3.4.0"
    },
    "devDependencies": {
        "@biomejs/biome": "2.4.0",
        "@tailwindcss/postcss": "^4.3.3",
        "@types/d3-array": "3.2.2",
        "@types/d3-shape": "3.1.8",
        "@types/react": "^19.2.10",
        "@types/react-dom": "^19.2.3",
        "biome-config-pixel": "2.1.7",
        "postcss": "^8.5.31",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "tailwindcss": "^4.3.3",
        "typescript": "^5.9.3"
    },
    "packageManager": "pnpm@10.8.0"
}
