{
    "title": "a card’s computed styles from a canvas",
    "tool": "audit_ui",
    "medium": "canvas",
    "styles": "styles/paper-card.json",
    "mistakes": [
        {
            "what": "radius 8 on a card",
            "rule": "radius",
            "at": "2K-0",
            "expectedIncludes": ["16", "card", "10", "item", "12", "control"]
        },
        {
            "what": "padding 13 off the scale",
            "rule": "spacing",
            "at": "2K-0",
            "expectedIncludes": ["12", "16"]
        },
        {
            "what": "a shadow on a static card",
            "rule": "shadow",
            "at": "2K-0",
            "expectedIncludes": ["none", "no shadow", "remove"]
        },
        {
            "what": "a 15px title",
            "rule": "type-size",
            "at": "2K-1",
            "expectedIncludes": ["13", "14", "16"]
        },
        {
            "what": "weight 600 on the title",
            "rule": "weight",
            "at": "2K-1",
            "expectedIncludes": ["500"]
        },
        {
            "what": "meta text in #9CA3AF",
            "rule": "text-tone",
            "at": "2K-2",
            "expectedIncludes": ["neutral-600", "#676767"]
        },
        { "what": "a 36 high button", "rule": "height", "at": "2K-3", "expectedIncludes": ["34"] },
        {
            "what": "a stock blue fill #3B82F6",
            "rule": "colour",
            "at": "2K-3",
            "expectedIncludes": ["action", "#3939e5"]
        },
        {
            "what": "weight 600 on a button",
            "rule": "weight",
            "at": "2K-3",
            "expectedIncludes": ["500"]
        },
        {
            "what": "radius 8 on a button",
            "rule": "radius",
            "at": "2K-3",
            "expectedIncludes": ["12", "control"]
        }
    ]
}
