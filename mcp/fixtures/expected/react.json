        },
        {
            "what": "a stock blue fill (bg-blue-600)",
            "rule": "colour",
            "at": "Toolbar.tsx:15",
            "expectedIncludes": ["action"]
        },
        {
            "what": "font-semibold",
            "rule": "weight",
            "at": "Toolbar.tsx:15",
            "expectedIncludes": ["font-medium", "500"]
        },
        {
            "what": "shadow-md on a button",
            "rule": "shadow",
            "at": "Toolbar.tsx:15",
            "expectedIncludes": ["none", "no shadow", "remove"]
