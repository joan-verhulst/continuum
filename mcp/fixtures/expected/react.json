            "expectedIncludes": ["rounded-card", "16"]
        },
        {
            "what": "border-2 where a hairline is 1px",
            "rule": "border-width",
            "at": "Toolbar.tsx:21",
            "expectedIncludes": ["1px"]
        },
        {
            "what": "shadow-lg on a static card",
